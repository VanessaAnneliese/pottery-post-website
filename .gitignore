# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the committed template of expected variable names (no secrets)
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code chat records (personal, not shipped)
chat-logs/

# Extracted site quotes (personal reference, not shipped)
/quotes.md

# Working assets (full-size originals, crops, mapping) — web copies live in public/
pottery-post_assets/

# Local paid-listings store (dev fallback)
.data
