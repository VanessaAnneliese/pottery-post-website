# Pottery Post — environment variables
#
# This is a TEMPLATE listing the variable names the app expects. It holds NO
# real secrets and is safe to commit. To use it locally, copy it to .env.local
# (which is gitignored) and fill in real values:
#
#   cp .env.local.example .env.local
#
# In production these are set in the Vercel project settings, not in a file.
# The app reads every one of these lazily, so the build still succeeds when a
# value is absent (e.g. before the paid directory launches).

# --- Email (directory + gallery submission notifications, via Resend) ---
RESEND_API_KEY=

# --- Paid directory (Stripe) -------------------------------------------------
# ONE shared Anneliese Designs Stripe account serves every Post site. Each site
# has its OWN webhook endpoint + signing secret. Keep TEST keys here until the
# Feb 1, 2027 launch, then switch to LIVE keys in Vercel.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The $5/yr recurring Price id from the shared Stripe account.
STRIPE_PRICE_ID=
# Signing secret of THIS site's webhook endpoint (…/api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=
# Stripe Tax (HST). Leave false until the account has Tax + HST registration set.
STRIPE_TAX_ENABLED=false

# Flips the submit form to paid (Stripe Checkout). LEAVE UNSET until Feb 1, 2027;
# unset = free mode (emails the owner via Resend). Set to "true" to go paid.
# NEXT_PUBLIC_DIRECTORY_PAID=true

# --- Listings storage (Vercel Blob) ------------------------------------------
# Where published (paid) listings persist. Without it, local dev falls back to a
# gitignored .data/ folder; production needs this set or published listings
# won't survive.
BLOB_READ_WRITE_TOKEN=
